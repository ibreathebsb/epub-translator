# epub-translator 的配置。复制为 .env 后修改；.env 不进版本库。
# 真实环境变量里已有的同名变量优先于这个文件。

# 用哪家：
#   openai   任何 OpenAI 兼容接口
#   google   Google Gemini
#   claude   本机的 Claude Code 命令行（claude -p），不需要密钥
EPUBTR_PROVIDER=google

# 模型名。google 的代号见 https://ai.google.dev/gemini-api/docs/models
# claude 类型填传给 claude --model 的值，如 sonnet
EPUBTR_MODEL=gemini-3.8-flash

# 密钥（claude 类型不需要）。不写的话，会改用环境变量 GEMINI_API_KEY 或 OPENAI_API_KEY
EPUBTR_API_KEY=

# ---- 以下都是可选项，需要时去掉行首的 # ----

# 接口地址。openai 类型一般要填，如 https://api.deepseek.com；google 类型走中转时填
# EPUBTR_BASE_URL=

# 单次输出的 token 上限。报告里出现“输出被截断”时再设
# EPUBTR_MAX_OUTPUT_TOKENS=32768

# 采样温度，不设则用模型默认值
# EPUBTR_TEMPERATURE=0.3

# 单次请求的超时秒数
# EPUBTR_TIMEOUT=600

# 是否要求服务端输出 JSON，默认 true
# EPUBTR_JSON_MODE=true

# 原样传给接口的附加设置，写成一行 JSON
# EPUBTR_EXTRA={"thinking_config": {"thinking_level": "low"}}
